# Copy this file to backend/.env and adjust values as needed.

# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://labborrow:labborrow@localhost:5432/labborrow?schema=public"

# Secrets used to sign JWTs. Use long, random values in production.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
ADMIN_JWT_SECRET="change-me-to-a-different-long-random-string"

# API server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# Local file storage for uploaded component/profile images
UPLOAD_DIR="uploads/components"
MAX_UPLOAD_SIZE_MB=5
