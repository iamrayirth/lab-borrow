{
  "name": "lab-borrow",
  "version": "1.0.0",
  "private": true,
  "description": "Student component rental platform - MVP",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "db:reset": "npm run db:reset --workspace backend",
    "test": "npm run test --workspace backend",
    "lint": "npm run lint --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
